# ============================================================================
# Core
# ============================================================================

# Admin token for /admin/* endpoints. Auto-generated at startup if unset.
MAXAPI_ADMIN_TOKEN=1234ABCD

# HTTP bind port
MAXAPI_PORT=8080

# Default TZ for time formatting
TZ=America/Sao_Paulo

# ============================================================================
# Database (PostgreSQL optional — falls back to SQLite with WAL enabled)
# ============================================================================

DB_USER=maxapi
DB_PASSWORD=maxapi
DB_NAME=maxapi
DB_HOST=db
DB_PORT=5432
DB_SSLMODE=false

# ============================================================================
# Webhooks
# ============================================================================

# Global webhook URL receives every event from every user (in addition to
# per-user webhooks). Optional.
MAXAPI_GLOBAL_WEBHOOK=https://example.com/webhook

# "json" (default when unset is "form") — encoding of the webhook body.
WEBHOOK_FORMAT=json

# Retry policy for webhook delivery. Retries fire on network errors, 5xx, 408,
# and 429. 4xx is treated as a client contract failure and is NOT retried.
WEBHOOK_RETRY_ENABLED=true
WEBHOOK_RETRY_COUNT=5      # total attempts per delivery
WEBHOOK_RETRY_DELAY=30     # seconds, base delay (doubled each attempt)

# ============================================================================
# RabbitMQ (optional — disabled when RABBITMQ_URL is empty)
# ============================================================================

RABBITMQ_URL=amqp://maxapi:maxapi@localhost:5672/
RABBITMQ_QUEUE=max_events

# Optional topic exchange. When set, events publish with routingKey = eventType
# (e.g. "Message", "ReadReceipt") and the queue binding is your concern.
# RABBITMQ_EXCHANGE=max.events

# Reconnect policy for the broker link.
RABBITMQ_RETRY_COUNT=10    # max reconnect attempts before giving up
RABBITMQ_RETRY_DELAY=5     # seconds, linear backoff multiplier

# ============================================================================
# MAX client reconnect (WebSocket supervision)
# ============================================================================

# Exponential backoff between reconnect attempts, capped at MAX_CONNECT_CAP.
MAX_CONNECT_DELAY=5        # seconds, first wait
MAX_CONNECT_CAP=300        # seconds, maximum wait per attempt
MAX_CONNECT_RETRIES=0      # 0 = retry forever; >0 fires ReconnectExhausted webhook when exceeded

# ============================================================================
# Concurrency limits
# ============================================================================

# Max concurrent heavy ops per user (media downloads, webhook-with-file).
# Prevents a single noisy user from starving others.
MAXAPI_USER_CONCURRENCY=4

# ============================================================================
# Account protection
# ============================================================================

# Mean time between two logins at startup, ms (each spread by +-50%).
MAX_STARTUP_LOGIN_INTERVAL_MS=1000

# ============================================================================
# Media limits
# ============================================================================

# A photo: its download, its decoded data and the body of POST /media/photo.
MAXAPI_PHOTO_MAX_BYTES=10485760
# Any other media sent or downloaded through the gateway.
MAXAPI_MEDIA_MAX_BYTES=52428800

# ============================================================================
# SSRF guard
# ============================================================================

# Every URL a caller gives (a photo, a file, a download) is fetched over
# http(s) only and never from a loopback / private / link-local / CGNAT /
# multicast / reserved address, checked on the address dialled.
# ALLOW_PRIVATE_HOSTS lists hosts (exact names, comma-separated) that may
# resolve to such addresses: the operator's own storage in the same network.
# ALLOW_PRIVATE_HOSTS=minio,storage.internal
# ALLOW_PRIVATE_IPS=true turns the guard off altogether: dev/test only.
# ALLOW_PRIVATE_IPS=false
